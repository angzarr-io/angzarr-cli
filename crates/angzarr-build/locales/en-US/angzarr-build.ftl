angzarr-build-no-out-dir = OUT_DIR is unset: run this from a build script
angzarr-build-io = { $path }: { $detail }
angzarr-build-protoc = protoc failed: { $detail }
angzarr-build-prost = prost-build failed: { $detail }
angzarr-build-codegen = { $error }
angzarr-build-buf = buf generate failed: { $detail }
angzarr-build-uv = uv failed: { $detail }
angzarr-build-interface-missing = { $path }, a policy's interface, is not there: its adapter translates no refusal; scaffold it, or move it back
