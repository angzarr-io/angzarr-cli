{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/angzarr-io/angzarr-cli/main/docs/model.v1.schema.json",
  "title": "angzarr component model, schema_version 1",
  "description": "The language-neutral component model `angzarr codegen model` writes and client-repo templates render (docs/templates.md). Every key is always present; lists may be empty; absent optional strings are \"\".",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "files",
    "proto_files"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "files": {
      "description": "Every proto file declaring a component anchor, in request order.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/File"
      }
    },
    "proto_files": {
      "description": "Every proto file a component message lives in, keyed by proto path.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ProtoFile"
      }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "names": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/name"
      }
    },
    "protoPath": {
      "type": "string",
      "pattern": "^[^/].*\\.proto$"
    },
    "ProtoFileFields": {
      "description": "A proto file's identity, language mapping options and top-level declaration names.",
      "type": "object",
      "required": [
        "path",
        "dir",
        "stem",
        "package",
        "options",
        "top_level_messages",
        "top_level_enums",
        "top_level_services"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/protoPath"
        },
        "dir": {
          "type": "string",
          "minLength": 1
        },
        "stem": {
          "$ref": "#/$defs/name"
        },
        "package": {
          "type": "string"
        },
        "options": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "go_package": {
              "type": "string"
            },
            "java_package": {
              "type": "string"
            },
            "java_outer_classname": {
              "type": "string"
            },
            "java_multiple_files": {
              "enum": [
                "true",
                "false"
              ]
            },
            "csharp_namespace": {
              "type": "string"
            },
            "objc_class_prefix": {
              "type": "string"
            },
            "php_namespace": {
              "type": "string"
            },
            "ruby_package": {
              "type": "string"
            },
            "swift_prefix": {
              "type": "string"
            }
          }
        },
        "top_level_messages": {
          "$ref": "#/$defs/names"
        },
        "top_level_enums": {
          "$ref": "#/$defs/names"
        },
        "top_level_services": {
          "$ref": "#/$defs/names"
        }
      }
    },
    "ProtoFile": {
      "$ref": "#/$defs/ProtoFileFields",
      "unevaluatedProperties": false
    },
    "File": {
      "description": "A ProtoFile plus the components it declares, in declaration order.",
      "$ref": "#/$defs/ProtoFileFields",
      "required": [
        "components"
      ],
      "properties": {
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Component"
          }
        }
      },
      "unevaluatedProperties": false
    },
    "MessageRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "full_name",
        "name",
        "nested_names",
        "package",
        "file"
      ],
      "properties": {
        "full_name": {
          "$ref": "#/$defs/name"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "nested_names": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/name"
          }
        },
        "package": {
          "type": "string"
        },
        "file": {
          "$ref": "#/$defs/protoPath"
        }
      }
    },
    "method": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9_]*$"
    },
    "Handler": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message",
        "method",
        "source_domain",
        "emits",
        "typed_emit"
      ],
      "properties": {
        "message": {
          "$ref": "#/$defs/MessageRef"
        },
        "method": {
          "$ref": "#/$defs/method"
        },
        "source_domain": {
          "type": "string"
        },
        "emits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MessageRef"
          }
        },
        "typed_emit": {
          "type": "boolean"
        }
      }
    },
    "Applier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message",
        "method"
      ],
      "properties": {
        "message": {
          "$ref": "#/$defs/MessageRef"
        },
        "method": {
          "$ref": "#/$defs/method"
        }
      }
    },
    "Rejection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "command",
        "domain",
        "method"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/name"
        },
        "command": {
          "$ref": "#/$defs/name"
        },
        "domain": {
          "type": "string"
        },
        "method": {
          "$ref": "#/$defs/method"
        }
      }
    },
    "Undo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "method"
      ],
      "properties": {
        "command": {
          "$ref": "#/$defs/name"
        },
        "method": {
          "$ref": "#/$defs/method"
        }
      }
    },
    "Fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message",
        "method"
      ],
      "properties": {
        "message": {
          "$ref": "#/$defs/MessageRef"
        },
        "method": {
          "$ref": "#/$defs/method"
        }
      }
    },
    "Component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "stub_name",
        "anchor",
        "state",
        "domain",
        "input_domain",
        "output_domains",
        "projector_domains",
        "emits_facts",
        "handlers",
        "appliers",
        "rejections",
        "undos",
        "facts",
        "finish_method",
        "referenced_files"
      ],
      "properties": {
        "kind": {
          "enum": [
            "AGGREGATE",
            "SAGA",
            "PROCESS_MANAGER",
            "PROJECTOR"
          ]
        },
        "name": {
          "$ref": "#/$defs/method"
        },
        "stub_name": {
          "$ref": "#/$defs/method"
        },
        "anchor": {
          "$ref": "#/$defs/MessageRef"
        },
        "state": {
          "oneOf": [
            {
              "$ref": "#/$defs/MessageRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "domain": {
          "type": "string"
        },
        "input_domain": {
          "type": "string"
        },
        "output_domains": {
          "$ref": "#/$defs/names"
        },
        "projector_domains": {
          "$ref": "#/$defs/names"
        },
        "emits_facts": {
          "$ref": "#/$defs/names"
        },
        "handlers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Handler"
          }
        },
        "appliers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Applier"
          }
        },
        "rejections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Rejection"
          }
        },
        "undos": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Undo"
          }
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Fact"
          }
        },
        "finish_method": {
          "oneOf": [
            {
              "const": ""
            },
            {
              "$ref": "#/$defs/method"
            }
          ]
        },
        "referenced_files": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/protoPath"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "SAGA"
              }
            }
          },
          "then": {
            "properties": {
              "state": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "state": {
                "$ref": "#/$defs/MessageRef"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "PROJECTOR"
              }
            }
          },
          "then": {
            "properties": {
              "finish_method": {
                "$ref": "#/$defs/method"
              }
            }
          },
          "else": {
            "properties": {
              "finish_method": {
                "const": ""
              },
              "projector_domains": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  }
}
